# LOCURA 2.0 Environment Configuration
# Copy this file to .env and provide your production cloud credentials when deploying.

# Firebase Cloud Suite (Authentication, Firestore, Cloud Messaging)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="locura-safety.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="locura-safety"
VITE_FIREBASE_STORAGE_BUCKET="locura-safety.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Google Maps Platform (Optional: Leaflet/OSM is default built-in fallback)
VITE_GOOGLE_MAPS_API_KEY=""

# OpenWeatherMap / National Disaster Alert API (Optional)
VITE_WEATHER_API_KEY=""
